{
  "name": "gitmoji-commits",
  "version": "0.2.0",
  "description": "Zero-config CLI to set up conventional commits + gitmoji + commitlint + husky + automated CHANGELOG in any project. Works with pnpm, npm, yarn and bun.",
  "keywords": [
    "gitmoji",
    "conventional-commits",
    "commitlint",
    "commitizen",
    "cz-git",
    "husky",
    "changelog",
    "semver",
    "cli",
    "setup",
    "init"
  ],
  "license": "MIT",
  "author": "rickydavinci",
  "homepage": "https://github.com/RickNoutat/gitmoji-commits#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RickNoutat/gitmoji-commits.git"
  },
  "bugs": {
    "url": "https://github.com/RickNoutat/gitmoji-commits/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gitmoji-init": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "commit": "git-cz",
    "release": "commit-and-tag-version",
    "release:patch": "commit-and-tag-version --release-as patch",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "prepare": "husky"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "picocolors": "^1.1.1",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/node": "^22.9.0",
    "@types/update-notifier": "^6.0.8",
    "commit-and-tag-version": "^12.7.1",
    "commitizen": "^4.3.1",
    "cz-git": "^1.13.0",
    "husky": "^9.1.7",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "packageManager": "pnpm@9.12.0",
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}
